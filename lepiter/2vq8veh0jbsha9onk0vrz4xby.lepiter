				},
				"code" : "| captured subscriber |\ncaptured := OrderedCollection new.\nsubscriber := Object new.\n[ SystemAnnouncer uniqueInstance\n\twhen: ClassAdded, ClassModificationApplied, MethodAdded, MethodModified\n\tdo: [ :ann |\n\t\tcaptured add: ann class name , ' | class: '\n\t\t\t, ([ ann classAffected name ] on: Error do: [ :e | '?' ])\n\t\t\t, ' | selector: '\n\t\t\t, ([ ann methodAffected selector ] on: Error do: [ :e | '-' ]) printString ]\n\tfor: subscriber.\n  Object subclass: #LeLiterateAnnouncementProbe\n\tinstanceVariableNames: '' classVariableNames: '' category: 'LeLiterateProvenanceProbe'.\n  (Smalltalk classNamed: #LeLiterateAnnouncementProbe) compile: 'answer ^ 42' classified: 'accessing'.\n  (Smalltalk classNamed: #LeLiterateAnnouncementProbe) class compile: 'defaultAnswer ^ 42' classified: 'accessing' ]\n\tensure: [ SystemAnnouncer uniqueInstance unsubscribe: subscriber ].\n(Smalltalk classNamed: #LeLiterateAnnouncementProbe) removeFromSystem.\ncaptured"
			},
