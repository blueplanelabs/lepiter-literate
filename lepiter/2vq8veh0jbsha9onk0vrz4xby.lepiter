				"code" : "LeLiterateProvenanceEntry class compile: 'forSnippet: aSnippet action: anAction sequence: aNumber\n\t^ self new\n\t\tsnippetUid: aSnippet uid;\n\t\tpageTitle: (aSnippet page ifNotNil: [ :aPage | aPage title ]);\n\t\tdatabaseName: (aSnippet database ifNotNil: [ :aDatabase | aDatabase databaseName ]);\n\t\taction: anAction;\n\t\tsequence: aNumber;\n\t\tlastAppliedAt: DateAndTime now;\n\t\tyourself' classified: 'instance creation'.\nLeLiterateProvenanceEntry compile: 'snippetUid\n\t^ snippetUid' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'snippetUid: aLeUID\n\tsnippetUid := aLeUID' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'pageTitle\n\t^ pageTitle' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'pageTitle: aString\n\tpageTitle := aString' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'databaseName\n\t^ databaseName' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'databaseName: aString\n\tdatabaseName := aString' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'action\n\t^ action' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'action: aSymbol\n\taction := aSymbol' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'sequence\n\t^ sequence' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'sequence: aNumber\n\tsequence := aNumber' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'lastAppliedAt\n\t^ lastAppliedAt' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'lastAppliedAt: aDateAndTime\n\tlastAppliedAt := aDateAndTime' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'printOn: aStream\n\tsuper printOn: aStream.\n\taStream\n\t\tnextPutAll: '' ('';\n\t\tnextPutAll: self action asString;\n\t\tnextPutAll: '' por snippet de la página: '';\n\t\tnextPutAll: (self pageTitle ifNil: [ ''?'' ]);\n\t\tnextPutAll: '')''' classified: 'printing'"
