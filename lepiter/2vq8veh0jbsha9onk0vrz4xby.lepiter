				"code" : "\"Extensiones moldables: las tres vistas <gtView> quedan en el paquete Lepiter-Literate\n mediante el protocolo de extensión *Lepiter-Literate.\"\nClassDescription compile: 'gtLiterateOriginFor: aView\n\t<gtView>\n\t| related |\n\trelated := LeLiterateProvenance default entriesRelatedToClassNamed: self instanceSide name asString.\n\trelated isEmpty ifTrue: [ ^ aView empty ].\n\t^ aView columnedList\n\t\ttitle: ''Literate origin'';\n\t\tpriority: 60;\n\t\titems: [ (LeLiterateProvenance default entriesRelatedToClassNamed: self instanceSide name asString) asOrderedCollection ];\n\t\tcolumn: ''Seq'' text: [ :each | each value sequence ] width: 50;\n\t\tcolumn: ''Artifact'' text: [ :each | each key ];\n\t\tcolumn: ''Action'' text: [ :each | each value action ];\n\t\tcolumn: ''Page'' text: [ :each | each value pageTitle ifNil: [ '''' ] ];\n\t\tcolumn: ''Applied'' text: [ :each | each value lastAppliedAt printString ];\n\t\tsend: [ :each | each value resolvedSnippet ifNil: [ each value ] ]' classified: '*Lepiter-Literate'.\nCompiledMethod compile: 'gtLiterateOriginFor: aView\n\t<gtView>\n\t| history |\n\thistory := LeLiterateProvenance default historyForMethod: self.\n\thistory isEmpty ifTrue: [ ^ aView empty ].\n\t^ aView columnedList\n\t\ttitle: ''Literate origin'';\n\t\tpriority: 60;\n\t\titems: [ (LeLiterateProvenance default historyForMethod: self) entries ];\n\t\tcolumn: ''Seq'' text: [ :each | each sequence ] width: 50;\n\t\tcolumn: ''Action'' text: [ :each | each action ];\n\t\tcolumn: ''Page'' text: [ :each | each pageTitle ifNil: [ '''' ] ];\n\t\tcolumn: ''Applied'' text: [ :each | each lastAppliedAt printString ];\n\t\tsend: [ :each | each resolvedSnippet ifNil: [ each ] ]' classified: '*Lepiter-Literate'.\nLeSnippet compile: 'gtGeneratedCodeFor: aView\n\t<gtView>\n\t| associations |\n\tself uid ifNil: [ ^ aView empty ].\n\tassociations := LeLiterateProvenance default entriesForSnippetUidString: self uid uidString.\n\tassociations isEmpty ifTrue: [ ^ aView empty ].\n\t^ aView columnedList\n\t\ttitle: ''Generated code'';\n\t\tpriority: 60;\n\t\titems: [ (LeLiterateProvenance default entriesForSnippetUidString: self uid uidString) asOrderedCollection ];\n\t\tcolumn: ''Seq'' text: [ :each | each value sequence ] width: 50;\n\t\tcolumn: ''Artifact'' text: [ :each | each key ];\n\t\tcolumn: ''Action'' text: [ :each | each value action ];\n\t\tsend: [ :each | (LeLiterateProvenance default artifactForKey: each key) ifNil: [ each value ] ]' classified: '*Lepiter-Literate'"
			},
