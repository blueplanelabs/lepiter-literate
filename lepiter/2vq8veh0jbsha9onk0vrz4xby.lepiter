				"uid" : {
					"__type" : "uid",
					"uidString" : "YFPUiauZQUibKphsFhrhZQ=="
				},
				"code" : "LeLiterateProvenance compile: 'historyForClass: aClass\n\t^ self historyForKey: (self keyForClass: aClass)' classified: 'accessing'.\nLeLiterateProvenance compile: 'historyForMethod: aCompiledMethod\n\t^ self historyForKey: (self keyForClass: aCompiledMethod methodClass selector: aCompiledMethod selector)' classified: 'accessing'.\nLeLiterateProvenance compile: 'entriesRelatedToClassNamed: aClassName\n\t\"Todas las entradas de la clase, sus métodos de instancia y sus métodos de lado clase,\n\tcomo asociaciones clave -> entrada ordenadas por secuencia global.\"\n\t| result |\n\tresult := OrderedCollection new.\n\thistories keysAndValuesDo: [ :key :history |\n\t\t(key = aClassName\n\t\t\tor: [ (key beginsWith: aClassName , ''>>#'')\n\t\t\t\tor: [ key beginsWith: aClassName , '' class'' ] ])\n\t\t\tifTrue: [ history entries do: [ :entry | result add: key -> entry ] ] ].\n\t^ result asSortedCollection: [ :a :b | a value sequence <= b value sequence ]' classified: 'accessing'.\nLeLiterateProvenance compile: 'entriesForSnippetUidString: aUidString\n\t\"Índice inverso: todas las asociaciones clave -> entrada producidas por un snippet.\"\n\t| result |\n\tresult := OrderedCollection new.\n\thistories keysAndValuesDo: [ :key :history |\n\t\thistory entries do: [ :entry |\n\t\t\tentry snippetUid uidString = aUidString ifTrue: [ result add: key -> entry ] ] ].\n\t^ result asSortedCollection: [ :a :b | a value sequence <= b value sequence ]' classified: 'accessing'.\nLeLiterateProvenance compile: 'artifactForKey: aKey\n\t\"Resuelve una clave a su artefacto vivo: la clase, o el CompiledMethod si aún existe.\"\n\t| index classPart selectorPart behavior |\n\tindex := aKey indexOfSubCollection: ''>>#''.\n\tindex = 0 ifTrue: [ ^ Smalltalk classNamed: aKey ].\n\tclassPart := aKey copyFrom: 1 to: index - 1.\n\tselectorPart := (aKey copyFrom: index + 3 to: aKey size) asSymbol.\n\tbehavior := (classPart endsWith: '' class'')\n\t\tifTrue: [ (Smalltalk classNamed: (classPart withoutSuffix: '' class'')) ifNotNil: [ :aClass | aClass class ] ]\n\t\tifFalse: [ Smalltalk classNamed: classPart ].\n\tbehavior ifNil: [ ^ nil ].\n\t^ behavior compiledMethodAt: selectorPart ifAbsent: [ behavior ]' classified: 'accessing'.\nLeLiterateProvenanceEntry compile: 'resolvedSnippet\n\t\"Resuelve perezosamente el snippet vivo por su UID en las bases registradas.\"\n\tself snippetUid ifNil: [ ^ nil ].\n\tLeDatabasesRegistry default currentLoadedDefaultLogicalDatabase databases\n\t\tdo: [ :aDatabase |\n\t\t\t(aDatabase blockWithUID: self snippetUid ifPresent: [ :aSnippet | aSnippet ] ifAbsent: [ nil ])\n\t\t\t\tifNotNil: [ :aSnippet | ^ aSnippet ] ].\n\t^ nil' classified: 'accessing'"
			},
