				"code" : "LeLiterateProvenance compile: 'initialize\n\tsuper initialize.\n\thistories := Dictionary new.\n\tinterestingPackageNames := Set new.\n\tsequenceCounter := 0' classified: 'initialization'.\nLeLiterateProvenance compile: 'addInterestingPackageNamed: aPackageName\n\tinterestingPackageNames add: aPackageName' classified: 'configuration'.\nLeLiterateProvenance compile: 'interestingPackageNames\n\t^ interestingPackageNames' classified: 'configuration'.\nLeLiterateProvenance compile: 'isInterestingPackageNamed: aPackageName\n\t\"Filtro explícito: con el filtro vacío no se registra nada.\"\n\t^ aPackageName notNil and: [ interestingPackageNames includes: aPackageName ]' classified: 'configuration'.\nLeLiterateProvenance compile: 'artifactKeys\n\t^ histories keys' classified: 'accessing'.\nLeLiterateProvenance compile: 'historyForKey: aKey\n\t^ histories at: aKey ifAbsent: [ LeLiterateCodeHistory new ]' classified: 'accessing'.\nLeLiterateProvenance compile: 'nextSequence\n\t^ sequenceCounter := sequenceCounter + 1' classified: 'private'.\nLeLiterateProvenance compile: 'keyForClass: aClass\n\t^ aClass name asString' classified: 'private'.\nLeLiterateProvenance compile: 'keyForClass: aClass selector: aSelector\n\t^ aClass name asString , ''>>#'' , aSelector asString' classified: 'private'.\nLeLiterateProvenance compile: 'capturingFor: aSnippet during: aBlock\n\tcurrentSnippet := aSnippet.\n\tSystemAnnouncer uniqueInstance\n\t\twhen: ClassAdded , ClassModificationApplied , ClassRemoved , MethodAdded , MethodModified , MethodRemoved\n\t\tdo: [ :anAnnouncement | self recordAnnouncement: anAnnouncement ]\n\t\tfor: self.\n\t^ aBlock ensure: [\n\t\tSystemAnnouncer uniqueInstance unsubscribe: self.\n\t\tcurrentSnippet := nil ]' classified: 'capturing'.\nLeLiterateProvenance compile: 'recordAnnouncement: anAnnouncement\n\t| affectedClass selector packageName key |\n\tcurrentSnippet ifNil: [ ^ self ].\n\taffectedClass := [ anAnnouncement classAffected ] on: Error do: [ :e | nil ].\n\taffectedClass ifNil: [ ^ self ].\n\tselector := [ anAnnouncement methodAffected ifNotNil: [ :aMethod | aMethod selector ] ]\n\t\ton: Error do: [ :e | nil ].\n\tpackageName := [ selector\n\t\tifNil: [ affectedClass package name ]\n\t\tifNotNil: [ anAnnouncement methodAffected package name ] ] on: Error do: [ :e | nil ].\n\t(self isInterestingPackageNamed: packageName) ifFalse: [ ^ self ].\n\tkey := selector\n\t\tifNil: [ self keyForClass: affectedClass ]\n\t\tifNotNil: [ self keyForClass: affectedClass selector: selector ].\n\tself recordKey: key action: (self actionForKey: key announcement: anAnnouncement)' classified: 'capturing'.\nLeLiterateProvenance compile: 'actionForKey: aKey announcement: anAnnouncement\n\t((anAnnouncement isKindOf: ClassRemoved) or: [ anAnnouncement isKindOf: MethodRemoved ])\n\t\tifTrue: [ ^ #removed ].\n\t^ (histories includesKey: aKey) ifTrue: [ #modified ] ifFalse: [ #created ]' classified: 'private'.\nLeLiterateProvenance compile: 'recordKey: aKey action: anAction\n\t| history entry |\n\thistory := histories at: aKey ifAbsentPut: [ LeLiterateCodeHistory new ].\n\tentry := LeLiterateProvenanceEntry\n\t\tforSnippet: currentSnippet\n\t\taction: anAction\n\t\tsequence: self nextSequence.\n\thistory addEntry: entry' classified: 'capturing'.\nLeLiterateProvenance compile: 'printOn: aStream\n\tsuper printOn: aStream.\n\taStream nextPutAll: '' (''; print: histories size; nextPutAll: '' artefactos)''' classified: 'printing'"
